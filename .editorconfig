# Root editorconfig file
root = true

[*.cs]
# Suppress SA001 globally
dotnet_diagnostic.SA001.severity = none

# SA1101: Prefix local calls with this
dotnet_diagnostic.SA1101.severity = none

# SA1309: Field names should not begin with underscore
dotnet_diagnostic.SA1309.severity = none

# SA1600: Elements should be documented
dotnet_diagnostic.SA1600.severity = none

# SA1633: File should have header
dotnet_diagnostic.SA1633.severity = none

# SA1623: Property summary documentation should match accessors
dotnet_diagnostic.SA1623.severity = none

# SA1310: Field names should not contain underscore
dotnet_diagnostic.SA1310.severity = none

# SA1010: Opening square brackets should be spaced correctly
dotnet_diagnostic.SA1010.severity = none

# NUnit2045: Use Assert.Multiple
dotnet_diagnostic.NUnit2045.severity = none

# IDE0290: Use main constructor
dotnet_diagnostic.IDE0290.severity = none

# S1118: Utility classes should not have public constructors
dotnet_diagnostic.S1118.severity = none

# CS8618:  Non-nullable property must contain a non-null value when exiting constructor. Consider declaring the property as nullable.
dotnet_diagnostic.CS8618.severity = none

# SA1601: Partial elements should be documented.
dotnet_diagnostic.CS8618.severity = none
