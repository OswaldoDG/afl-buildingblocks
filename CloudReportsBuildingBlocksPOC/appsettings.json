{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Descope": {
    "ProjectId": "",
    "ManagementKey": "",
    "AuthorityUrl": "https://api.descope.com/v1/apps"
  },
  "ConnectionStrings": {
    "sors": "",
    "master": ""
  },
  "TempDirectory": "c:\\temp",
  "FileSystemContentCachedMinutes": 5,
  "GcpStorage": {
    "BucketName": "afl-oswaldo",
    "SignedUrlBatchSize": 100,
    "SignedUrlExpirationMinutes": 60
  },
  "PubSub": {
    "ProjectId": "conta-bee",
    "FileEventsTopic": "afl-file-event",
    "FileEventsSubscription": "afl-file-events-suscription",
    "Retry": {
      "MaxRetryAttempts": 3,
      "InitialDelayMilliseconds": 100,
      "MaxDelaySeconds": 30
    },
    "CircuitBreaker": {
      "FailureThreshold": 5,
      "DurationOfBreakSeconds": 30,
      "SamplingDurationSeconds": 60
    },
    "Subscriber": {
      "MaxConcurrentMessages": 10,
      "AckDeadlineSeconds": 60,
      "MaxAckExtensionSeconds": 10,
      "EnableMessageOrdering": false
    }
  }
}
