# @name CompleteBatchWithErrors
POST https://localhost:7141/api/sors/batch/complete/1
Authorization: Bearer {{jwt}}
Content-Type: application/json

{  
  "id": 1,
  "items": [
    {
      "id": "1"
    },
    {
      "id": "2",
      "errored": true,
      "errorMessage": "File format not supported"
    }
  ]
 }

