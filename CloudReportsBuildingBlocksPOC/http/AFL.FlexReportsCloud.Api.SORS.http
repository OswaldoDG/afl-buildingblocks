# @name CreateBatch

POST https://localhost:7141/api/sors/batch 
Authorization: Bearer {{jwt}}
Content-Type: application/json

{
"name": "Batch 1",
"destinationFolder": "/reports/batch1",
"items": [ 
  {
    "itemId": "1",
    "fileName": "data001.otdr",
    "size": 1024
  },
  {
    "itemId": "2",
    "fileName": "data002.otdr",
    "size": 1024
  }
  ]
}

###

