# @name CompleteBatch
# Complete a batch 
POST https://localhost:7141/graphql
X-REQUEST-TYPE: GraphQL
Content-Type: application/json
Authorization: Bearer {{jwt}}

mutation FinalizeBatch($input: CompleteBatchInput!) {
  completeBatch(input: $input) {
    boolean
    errors {
      ... on ArgumentError {
        message
        paramName
      }
    }
  }
}

{
  "input": {
    "id": 17,
    "input": {
      "id": 17,
      "items": [
        {
          "id": 31
        },
        {
          "id": 32
        }
      ]
    }
  }
}

