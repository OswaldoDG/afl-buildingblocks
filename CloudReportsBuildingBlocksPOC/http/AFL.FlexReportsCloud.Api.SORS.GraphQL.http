# @name CreateBatch
# Create a batch with 2 OTDR files
POST https://localhost:7141/graphql
X-REQUEST-TYPE: GraphQL
Content-Type: application/json
Authorization: Bearer {{jwt}}

mutation CreateNewBatch($input: CreateBatchInput!) {
  createBatch(input: $input) {
    batchResponseDto {
      id
      name
      destinationFolder
      batchStatus
      items {
        id
        itemId
        uploadUrl
      }
    }
  }
}

{
  "input": {
    "input": {
      "name": "Upload_Project_Alpha",
      "destinationFolder": "/uploads/documents/2026-b",
      "items": [
        {
          "itemId": "1",
          "fileName": "F01C10A_P00001.atd",
          "size": 102400
        },
        {
          "itemId": "2",
          "fileName": "F01C10A_P00002.atd",
          "size": 5242880
        }
      ]
    }
  }
}

